# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Sonosphere application credentials (sonosphere.fm -> Settings -> Applications)
SONOSPHERE_API_KEY=
SONOSPHERE_SHARED_SECRET=

# Optional
SONOSBOT_PREFIX=.
SONOSBOT_DB=sonosbot.db
SONOSBOT_TEXT_COMMANDS=true
SONOSBOT_MEMBERS_INTENT=true
# SONOSBOT_DEV_GUILD_ID=
# SONOSBOT_OWNER_IDS=
# SONOSBOT_INDEX_MAX_AGE_HOURS=48
# SONOSBOT_DEBUG=false
